{
  "name": "CoDiVE-KC = 冻结 base + EGMR（Exemplar-Grounded Multimodal Retrieval）",
  "created_at": "2026-11-03T23:54:24+08:00",
  "updated_at": "2026-11-03T23:55:41+08:00",
  "method": "免训练插件：在冻结 base 最终分数 f 的 Top-K 候选上，用训练集样例做类别均衡的候选条件检索。sim = cos(h_q,h_j) + β·cos(v_q,v_j)·1[双方有图]；e_{q,c} = 标签 c 的前 m 个最相似训练样例的平均相似度；S_{q,c} = f_{q,c} + λ(e_{q,c} − 候选均值)，非候选不变；冲突感知标签集合处理完全相同输入的标签冲突。",
  "datasets": [
    "Math",
    "Biology"
  ],
  "seeds": {
    "main": [
      200404,
      200405,
      200406,
      200407,
      200408
    ],
    "separate_teacher": [
      200409
    ]
  },
  "variants": {
    "base": "λ=0（冻结 base 输出）",
    "knn_global": "kNN-LM 式全局近邻插值（对照）",
    "egmr_text": "EGMR，β=0",
    "egmr_mm": "EGMR 多模态，β>0",
    "egmr_mm_noconflict": "EGMR 多模态，不用冲突感知标签（消融）",
    "egmr_mm_permuted": "零对照：训练标签按种子随机置换，同网格同选择规则；度量 val_select 网格选择的乐观偏差"
  },
